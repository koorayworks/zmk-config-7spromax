/*
 * 7sProMax production keymap (ZMK v0.3, BLE Micro Pro x2 split).
 *
 * Physical layout (verified on the real board 2026-11-23/24, see
 * MAPPING.md): the two halves dock into one HHKB-style unit.
 * Combined rows, left to right:
 *   row A (15): left (0,0)-(0,5) | right (5,0)-(5,7), (6,7)
 *   row B (14): left (1,0)-(1,5) | right (6,0)-(6,6), (7,7)
 *   row C (13): left (2,0)-(2,5) | right (7,0)-(7,6)
 *   row D (13): left (3,0)-(3,5) | right (8,0)-(8,6)
 *   row E ( 8): left (4,0),(4,2),(4,3),(4,4) | right (9,0),(9,1),(9,3),(9,4)
 * Tact switches: left (0,7),(1,7),(2,7) / right (9,5),(9,6),(9,7).
 * Unpopulated positions are bound to &none.
 *
 * LED: WS2812/SK6812 chain, data = BMP config pin 1 = Pro Micro TX0
 * = nRF P0.11 (see NOTES.md), 16 LEDs per half (official config value).
 * Driven over SPIM3 exactly like the Corne v2 BMP build; standard ZMK
 * underglow is the animation engine here (no custom lighting engine).
 *
 * ZMK Studio: central (left) is built with the studio-rpc-usb-uart
 * snippet + custom-settings flags (see build-vm.sh / build-local.sh).
 * Locking is disabled in 7spromax.conf, so Studio works right after
 * boot; &studio_unlock sits on the Fn layer anyway.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/led/led.h>

&pinctrl {
    spromax_rgb_spi3_default: spromax_rgb_spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 11)>;
        };
    };

    spromax_rgb_spi3_sleep: spromax_rgb_spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 11)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spromax_rgb_spi3_default>;
    pinctrl-1 = <&spromax_rgb_spi3_sleep>;
    pinctrl-names = "default", "sleep";

    spromax_led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <16>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/ {
    chosen {
        zmk,underglow = &spromax_led_strip;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            /* left half: rows 0-4 (cols 0-7) */
            &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &none           &rgb_ug RGB_TOG
            &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &none           &kp C_VOL_DN
            &kp LCTRL &kp A     &kp S     &kp D     &kp F     &kp G     &none           &kp C_VOL_UP
            &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &none           &none
            &kp LALT  &none     &kp LGUI  &kp SPACE &mo 1     &none     &none           &none
            /* right half: rows 5-9 (cols 0-7) */
            &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL       &kp BSLH
            &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT        &kp GRAVE
            &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp ENTER       &kp BSPC
            &kp N     &kp M     &kp COMMA &kp DOT   &kp SLASH &kp RSHFT &mo 1           &none
            &kp SPACE &kp RGUI  &none     &kp RALT  &kp RCTRL &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_EFF
            >;
        };

        fn_layer {
            bindings = <
            /* left half */
            &studio_unlock &kp F1   &kp F2    &kp F3    &kp F4    &kp F5    &none           &bt BT_CLR
            &kp CAPS  &trans  &trans  &trans  &trans  &trans  &none           &bt BT_SEL 0
            &trans    &trans  &trans  &trans  &trans  &trans  &none           &bt BT_SEL 1
            &trans    &trans  &trans  &trans  &trans  &trans  &none           &none
            &bootloader &none   &trans  &trans  &trans  &none     &none           &none
            /* right half */
            &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12         &kp DEL
            &trans    &trans  &trans  &trans  &trans  &kp PG_UP &kp PG_DN       &kp PSCRN
            &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp HOME  &kp END   &trans          &trans
            &trans    &trans  &trans  &trans  &trans  &trans  &trans          &none
            &trans    &trans  &none     &trans  &sys_reset &bt BT_SEL 2 &bt BT_SEL 3    &bt BT_SEL 4
            >;
        };
    };
};
