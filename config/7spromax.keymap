/*
 * 7sProMax TEST keymap (bring-up draft).
 *
 * Every one of the 80 matrix positions gets a distinct, identifiable
 * key so that pressing each physical switch on the real board reveals
 * its (row, col). The physical (row, col) -> key correspondence is
 * NOT yet known (see NOTES.md); this keymap is the tool to find out.
 *
 * Position order follows the shared 10x8 matrix transform:
 *   positions  0-39: left  half, rows 0-4 x cols 0-7
 *   positions 40-79: right half, rows 5-9 x cols 0-7
 *
 * Two positions are sacrificed for layer access:
 *   left  row 4 col 0 (position 32) and right row 9 col 7
 *   (position 79) are &mo 1. Layer 1 carries &bootloader /
 *   &sys_reset / Bluetooth controls so the board can always be
 *   re-flashed from the keymap itself.
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            /* left half: rows 0-4 */
            &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8
            &kp N9    &kp N0    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y
            &kp U     &kp I     &kp O     &kp P     &kp A     &kp S     &kp D     &kp F
            &kp G     &kp H     &kp J     &kp K     &kp L     &kp Z     &kp X     &kp C
            &mo 1     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp SLASH
            /* right half: rows 5-9 */
            &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8
            &kp F9    &kp F10   &kp F11   &kp F12   &kp GRAVE &kp MINUS &kp EQUAL &kp BSLH
            &kp LBKT  &kp RBKT  &kp SEMI  &kp SQT   &kp HOME  &kp END   &kp PG_UP &kp PG_DN
            &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_N7 &kp KP_N8
            &kp KP_N9 &kp KP_N0 &kp KP_DOT &kp KP_ENTER &kp KP_PLUS &kp KP_MINUS &kp KP_MULTIPLY &mo 1
            >;
        };

        system_layer {
            bindings = <
            /* left half */
            &bootloader &sys_reset &bt BT_CLR &bt BT_SEL 0 &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans
            /* right half */
            &bootloader &sys_reset &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
